# Database (Prisma Postgres)
DATABASE_URL="postgres://YOUR_CONNECTION_STRING"

# Resend — for sending emails (https://resend.com/api-keys)
RESEND_API_KEY="re_YOUR_API_KEY_HERE"

# Email you want to SEND FROM (must be verified domain in Resend, or use onboarding@resend.dev for testing)
EMAIL_FROM="onboarding@resend.dev"

# Email you want to RECEIVE lead notifications at (optional — leave empty if using Telegram only)
NOTIFICATION_EMAIL=""

# Telegram Bot (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID="YOUR_CHAT_ID_HERE"

# Admin password for /admin dashboard
ADMIN_PASSWORD="change-this-to-a-strong-password"

# MTA-STS email security (optional — defaults shown)
# SENDING_DOMAIN="blokblokstudio.com"
# MX_HOST="mail.blokblokstudio.com"
# MTA_STS_MODE="testing"

# EasyReach CRM webhook (forwards form submissions to your CRM)
EASYREACH_WEBHOOK_URL=""
EASYREACH_WEBHOOK_SECRET=""

# Meta Conversions API (server-side Lead events, optional but recommended)
META_CAPI_ACCESS_TOKEN=

# Client job tracker webhook — leads become PROSPECT clients in the tracker.
# The secret must equal the tracker's own LEAD_WEBHOOK_SECRET.
TRACKER_WEBHOOK_URL=""
TRACKER_WEBHOOK_SECRET=""

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile).
# Both must be set for the CAPTCHA to do anything: with no site key the
# widget never renders, and with no secret the server skips verification.
# The widget's allowed-hostnames list must include every domain you deploy
# to, or it fails to load there.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
